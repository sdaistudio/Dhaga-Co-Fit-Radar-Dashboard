# Copy to .env and fill in. Never commit .env.
# Which reader: auto | anthropic | openai | offline
FITRADAR_PROVIDER=auto

# Claude (default)
ANTHROPIC_API_KEY=
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_STRONG_MODEL=claude-sonnet-5-5

# GPT (optional). Fill in the model names and prices you choose; see docs/MODEL_OPTIONS.md
OPENAI_API_KEY=
OPENAI_FAST_MODEL=
OPENAI_STRONG_MODEL=
OPENAI_FAST_PRICE_IN=0
OPENAI_FAST_PRICE_OUT=0
OPENAI_STRONG_PRICE_IN=0
OPENAI_STRONG_PRICE_OUT=0

USD_TO_INR=88
