# Copy to .env and fill in. Never commit .env.
# Which reader: auto | anthropic | openrouter | openai | offline
FITRADAR_PROVIDER="openrouter"

# OpenRouter (one key, many models). Model ids are "vendor/model"; prices are per million tokens
# and must match the models you pick. Defaults below are the same Claude pair.
OPENROUTER_API_KEY=
OPENROUTER_FAST_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_STRONG_MODEL=anthropic/claude-sonnet-5.5
OPENROUTER_FAST_PRICE_IN=1.00
OPENROUTER_FAST_PRICE_OUT=5.00
OPENROUTER_STRONG_PRICE_IN=2.00
OPENROUTER_STRONG_PRICE_OUT=10.00


# Read only the first N comments (0 = all). Use 5 to 10 for a cheap test of the model path.
FITRADAR_MAX_COMMENTS=0

USD_TO_INR=99
